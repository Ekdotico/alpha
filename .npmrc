@ekdotico:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# Exact versions, no caret and no tilde, as praktico has always had.
#
# This file carried ^0.11.0 for the design system, which looked harmless because
# all three applications resolved to the same version. It is a latent fork: the
# day 0.12.0 published it would have reached this site through a routine install,
# carrying a visual change that never passed the four-theme review gate, with no
# commit to point at. An upgrade is a deliberate act. Rule 16.
save-exact=true

# This credential line is required, and only for one of the three places this
# repository is installed. It was removed once on the reasoning that it
# authenticated nothing anywhere, which was checked in two environments and not
# in the third — the one that ships the site. The Vercel build then failed with
# ERR_PNPM_FETCH_401, "No authorization header was set for the request".
#
#   Vercel          NEEDS THIS LINE. There is no setup-node step to write a
#                   user-level .npmrc, so the project file plus the
#                   NODE_AUTH_TOKEN project environment variable is the whole
#                   mechanism, and the pnpm Vercel runs does expand it.
#   GitHub Actions  ignores it, with a warning, because a newer pnpm refuses to
#                   expand a credential from a committed file. Harmless: the
#                   credential there comes from actions/setup-node with BOTH
#                   registry-url and scope: '@ekdotico'. Setting registry-url
#                   alone would write a bare `registry=` and, since GitHub
#                   Packages does not proxy npmjs, break next and react.
#   locally         not needed if the credential is in global config, which is
#                   where a person's belongs:
#                     pnpm config set "//npm.pkg.github.com/:_authToken" <token> --global
#
# THE TRAP, because it has already cost a real token once: `pnpm config set`
# writes to the nearest project .npmrc unless given --global, so it will
# overwrite the ${NODE_AUTH_TOKEN} above with a literal secret in a tracked
# file. Always pass --global. If it happens, `git checkout -- .npmrc` before
# staging anything.
#
# Also note: if NODE_AUTH_TOKEN is unset, pnpm cannot parse this file and
# DISCARDS IT WHOLE — including the scope mapping above — so installs fall
# through to npmjs and 404 on a package that was never there. That is what a
# sudden "not in the npm registry" means locally.

# pnpm 10 auto-installs a missing peer even when the package marks it optional.
# @ekdotico/amyntico declares @clerk/backend as an optional peer that only its
# auth module reads, and this site takes the headers module alone, so the SDK
# and its tree must not be installed here. Off, and unmet peers warn instead.
# The setting is repository-wide: it applies to every optional peer, not only Clerk.
auto-install-peers=false
