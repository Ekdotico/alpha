# Every variable below may be left blank locally: the form then runs against
# Cloudflare's always-pass Turnstile test keys, skips Brevo with a warning, and
# leaves the rate limits open. In production a missing value refuses every
# signup with "could not be added" and names the variable in the log.

# --- Brevo (stores the waitlist; sends the double opt-in email) ---
# API key: Brevo, SMTP & API, API Keys. Server-only; never NEXT_PUBLIC_.
BREVO_API_KEY=
# The numeric ID of the waitlist contact list (Contacts, Lists).
BREVO_LIST_ID=
# The numeric ID of a Double opt-in (DOI) template (Campaigns, Templates). Its
# button must link to {{ doubleoptin }}; Brevo replaces it with the link.
BREVO_DOI_TEMPLATE_ID=
# The numeric ID of the "User testing" list. A reader who ticks the testing box
# joins it on confirmation, and a Brevo automation on "added to this list"
# sends the testing email, as a marketing email so its unsubscribe link reaches
# the campaign blocklist. Needed only once the box is in use: in production a
# ticked box with this unset is refused rather than dropped.
BREVO_TESTING_LIST_ID=

# --- Cloudflare Turnstile (spam check on the form) ---
# Cloudflare dashboard, Turnstile, Add widget: hostname alpha.ekdoti.co only
# (local dev uses the test keys), mode Managed. The site key is public by
# design; the secret is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Upstash (rate limits; provisioned by the Vercel Marketplace integration) ---
# Create the database in eu-central-1. The integration injects KV_REST_API_URL
# and KV_REST_API_TOKEN, which the code accepts alongside the pair below. For
# local dev: `vercel env pull .env.local` after linking.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
